# StoryBridge Environment Configuration

# AI Engine / NVIDIA NIM Configuration
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_NAME=meta/llama-3.3-70b-instruct
# Alternative models on NVIDIA NIM:
# NIM_MODEL_NAME=meta/llama-3.1-405b-instruct
# NIM_MODEL_NAME=mistralai/mixtral-8x22b-instruct

# AI Engine Service
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000

# Backend Service
BACKEND_PORT=8080
JWT_SECRET=storybridge_super_secret_jwt_key_that_is_at_least_256_bits_long_2026

# Database & Storage
POSTGRES_DB=storybridge
POSTGRES_USER=storybridge_user
POSTGRES_PASSWORD=storybridge_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=storybridge-artifacts

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
