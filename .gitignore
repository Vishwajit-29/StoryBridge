# =============================================================================
# StoryBridge Master .gitignore
# =============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
*.env
!.env.example
*.pem
*.key

# --- Python & AI Engine ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Java & Spring Boot / Maven ---
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
.mvn/.cache
.flattened-pom.xml

# --- Node, Vite & React Frontend ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- Storage & Dynamic Artifacts ---
# Preserve seed story and directory anchors
storage/artifacts/*
!storage/artifacts/story_panchatantra_monkey_wedge/
!storage/artifacts/.gitkeep
backend/storage/artifacts/*
!backend/storage/artifacts/story_panchatantra_monkey_wedge/
!backend/storage/artifacts/.gitkeep
ai-engine/storage/artifacts/*

# --- IDEs & System ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
